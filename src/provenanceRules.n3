@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
# Helper terms of these rules; inferProvenance leaves them out of its result.
@prefix internal: <https://w3id.org/rdf-connect/provenance-rules#>.

# subclass rule
{
    ?S a ?A.
    ?A rdfs:subClassOf ?B.
} => {
    ?S a ?B.
}.

{ ?P rdfs:subClassOf ?Q.
  ?Q rdfs:subClassOf ?R. }
    => { ?P rdfs:subClassOf ?R. }.

# subproperty rule
{ ?P rdfs:subPropertyOf ?Q.
  ?S ?P ?O. }
    => { ?S ?Q ?O. }.

{ ?P rdfs:subPropertyOf ?Q.
  ?Q rdfs:subPropertyOf ?R. }
    => { ?P rdfs:subPropertyOf ?R. }.

# inverse rule
{ ?P owl:inverseOf ?Q.
  ?S ?P ?O. }
    => { ?O ?Q ?S. }.

# The configuration of a processor: the processor itself, and every node it
# reaches through a property that one of its shapes describes with a nested
# shape, such as rdfc:channels sh:class ex:Channels. The walk follows the shapes,
# not the kind of node: a configuration node may be a blank node or an IRI.
# Properties that no shape describes are not followed, nor are values that are
# processors themselves, so the channels of one processor are never credited
# to another.
#
# The shapes of a configuration node are kept per processor, as
# (?P ?N) internal:shape ?S: a node that two processors reach through
# different shapes only has, for each processor, the shapes of that processor.
# Triples with a list as subject cannot be represented in RDF/JS, so they never
# reach the result.

# The value of a property that a shape declares, or each member of a list value.
{
  ?PS sh:path ?p.
  ?N ?p ?M.
} => {
  (?N ?p) internal:value ?M.
}.

{
  ?PS sh:path ?p.
  ?N ?p ?L.
  ?L list:member ?M.
} => {
  (?N ?p) internal:value ?M.
}.

# The classes a shape targets: through sh:targetClass, or implicitly, when the
# shape is a class itself.
{
  ?S sh:targetClass ?C.
} => {
  ?S internal:targets ?C.
}.

{
  ?S a sh:NodeShape, rdfs:Class.
} => {
  ?S internal:targets ?S.
}.

# The shape of the values of a property: through sh:class and the shapes that
# target that class or one of its superclasses, or directly through sh:node.
{
  ?PS sh:class ?C.
  ?S internal:targets ?C.
} => {
  ?PS internal:valueShape ?S.
}.

{
  ?PS sh:class ?C.
  ?C rdfs:subClassOf ?D.
  ?S internal:targets ?D.
} => {
  ?PS internal:valueShape ?S.
}.

{
  ?PS sh:node ?S.
} => {
  ?PS internal:valueShape ?S.
}.

# A configuration node with a type has, for that processor, the shapes that
# target the type. Subclasses are covered by the subclass rule above.
{
  ?P a rdfc:Processor.
  ?P a ?C.
  ?S internal:targets ?C.
} => {
  (?P ?P) internal:shape ?S.
}.

{
  (?P ?N) internal:shape ?S0.
  ?N a ?C.
  ?S internal:targets ?C.
} => {
  (?P ?N) internal:shape ?S.
}.

# A shape that includes other shapes, through sh:node or sh:and, gives the
# node those shapes too.
{
  (?P ?N) internal:shape ?S.
  ?S sh:node ?S2.
} => {
  (?P ?N) internal:shape ?S2.
}.

{
  (?P ?N) internal:shape ?S.
  ?S sh:and ?L.
  ?L list:member ?S2.
} => {
  (?P ?N) internal:shape ?S2.
}.

# A nested property, sh:path ( ), applies its shape to the same node.
{
  (?P ?N) internal:shape ?S.
  ?S sh:property ?PS.
  ?PS sh:path rdf:nil;
      internal:valueShape ?S2.
} => {
  (?P ?N) internal:shape ?S2.
}.

# A value of a property that some shape describes with a nested shape can be
# followed, unless it is a processor itself. This negation lives in its own
# rule, which does not depend on the walk below: eyeling evaluates
# log:notIncludes against a snapshot of the closure, so in the recursive walk
# it would stop the walk after its first step.
{
  ?PS sh:path ?p;
      internal:valueShape ?S2.
  (?N ?p) internal:value ?M.
  ?SCOPE log:notIncludes { ?M a rdfc:Processor. }.
} => {
  ?M internal:followable true.
}.

# Follow a described property to its values.
{
  (?P ?N) internal:shape ?S.
  ?S sh:property ?PS.
  ?PS sh:path ?p;
      internal:valueShape ?S2.
  (?N ?p) internal:value ?M.
  ?M internal:followable true.
} => {
  (?P ?M) internal:shape ?S2.
}.

# A channel in the configuration of a processor, for a property that a shape
# of that configuration node, for that processor, declares as a reader or a
# writer.
{
  (?P ?N) internal:shape ?S.
  ?S sh:property ?PS.
  ?PS sh:path ?p;
      sh:class rdfc:Reader.
  (?N ?p) internal:value ?C.
  ?C a rdfc:Reader.
} => {
  ?P prov:used ?C.
}.

{
  (?P ?N) internal:shape ?S.
  ?S sh:property ?PS.
  ?PS sh:path ?p;
      sh:class rdfc:Writer.
  (?N ?p) internal:value ?C.
  ?C a rdfc:Writer.
} => {
  ?P prov:generated ?C.
}.
